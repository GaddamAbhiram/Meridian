# Copy this file to .env.local and fill in real values.

# Create a Live Monitor for this app's URL in the real BoLD product, then paste
# the ingest URL + key it gives you here.
BOLD_INGEST_URL=
BOLD_INGEST_KEY=

# Tells the SDK which response field names to look for as the object's owner.
BOLD_OWNER_FIELDS=customerId

# Tells the SDK which field names on a write are write-protected and shouldn't
# be settable by an ordinary customer (used by the BOPLA / mass-assignment routes).
BOLD_SENSITIVE_FIELDS=role,storeCredit

# Tells the SDK which response field name carries the object's owning tenant
# (used by the tenant-isolation routes).
BOLD_TENANT_FIELDS=storeId
